{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    {
      "source": "/products/solar-erp-10x",
      "destination": "/products/saurya-2x",
      "permanent": true
    },
    {
      "source": "/demos/solar-erp-10x/:file",
      "destination": "/demos/saurya-2x/:file",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
